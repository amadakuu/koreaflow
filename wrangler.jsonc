{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koreaflow",
  "compatibility_date": "2026-08-16",
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "koreaflow-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
